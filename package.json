{
  "name": "chameleye",
  "version": "0.1.0",
  "description": "ChamelEye — 360° vision for your codebase. Like a chameleon eye, see every execution & data flow independently. Architecture debugger for TypeScript/JS",
  "type": "module",
  "bin": {
    "chameleye": "./dist/cli.js",
    "flowmap": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc --noEmit"
  },
  "keywords": ["cli", "chameleon", "architecture", "visualization", "typescript", "static-analysis", "data-flow", "eye", "360"],
  "license": "MIT",
  "author": "Joyal J Joy",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoyalJJoy/chameleye"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3"
  }
}
